---
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>내 사주 보기</title>
  </head>

  <body>
    <main>
      <header class="hero">
        <p class="brand"><span class="brand-mark" aria-hidden="true"></span>내 사주 보기</p>
        <p class="eyebrow">나를 알아가는 작은 시작</p>
        <h1>생년월일로 보는<br />나의 사주 흐름</h1>
        <p class="hero-description">태어난 날에 담긴 사주와 올해의 흐름을 살펴보세요.<br class="desktop-break" /> 나의 일과 관계를 돌아보는 참고가 될 수 있어요.</p>
      </header>

      <form id="saju-form" aria-labelledby="form-heading">
        <div class="card-heading">
          <h2 id="form-heading">태어난 정보를 알려주세요</h2>
          <p>기본 정보로 나의 사주를 확인해요.</p>
        </div>
        <div class="field-grid">
        <div class="field">
          <label for="birthDate">생년월일</label>
          <input
            id="birthDate"
            name="birthDate"
            type="date"
            required
          />
        </div>

        <div class="field">
          <label for="birthTime">태어난 시간 <span class="optional">선택</span></label>
          <input
            id="birthTime"
            name="birthTime"
            type="time"
            aria-describedby="birth-time-help"
          />
          <p id="birth-time-help" class="field-help">시간을 모르면 비워두세요.</p>
        </div>

        <div class="field">
          <label for="gender">성별</label>
          <select id="gender" name="gender" required>
            <option value="">선택</option>
            <option value="male">남성</option>
            <option value="female">여성</option>
          </select>
        </div>

        <div class="field">
          <label for="calendarType">양력 · 음력</label>
          <select id="calendarType" name="calendarType" required>
            <option value="solar">양력</option>
            <option value="lunar">음력</option>
          </select>
        </div>
        </div>

        <label class="checkbox-row">
          <input
            type="checkbox"
            id="isLeapMonth"
            name="isLeapMonth"
          />
          <span>윤달 <span class="checkbox-hint">음력 생일이 윤달인 경우 선택해 주세요.</span></span>
        </label>

        <button type="submit">
          사주 결과 보기
        </button>

        <p id="error-message" role="status" aria-live="polite"></p>
      </form>
      <aside class="service-note" aria-label="서비스 이용 안내">
        <p>기본 사주 결과는 무료로 제공해요.</p>
        <p>상세 리포트는 결과를 확인한 후 선택할 수 있어요.</p>
      </aside>
    </main>

    <script>
      const form = document.querySelector('#saju-form')
      const errorMessage =
        document.querySelector('#error-message')

      form?.addEventListener('submit', async (event) => {
        event.preventDefault()

        if (!(form instanceof HTMLFormElement)) {
          return
        }

        const formData = new FormData(form)

        const body = {
          birthDate: formData.get('birthDate'),
          birthTime: formData.get('birthTime') || null,
          gender: formData.get('gender'),
          calendarType: formData.get('calendarType'),
          isLeapMonth:
            formData.get('isLeapMonth') === 'on',
        }

        const response = await fetch('/api/saju/profile', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(body),
        })

        const result = await response.json()

        if (typeof result !== 'object' || result === null) {
          if (errorMessage) errorMessage.textContent = '응답을 확인할 수 없습니다.'
          return
        }

        if (!response.ok) {
          if (errorMessage) {
            errorMessage.textContent =
              'message' in result && typeof result.message === 'string'
                ? result.message
                : '오류가 발생했습니다.'
          }

          return
        }

        if ('profileId' in result && typeof result.profileId === 'string') {
          window.location.href = `/result/${encodeURIComponent(result.profileId)}`
        } else if (errorMessage) {
          errorMessage.textContent = '사주 결과 주소를 확인할 수 없습니다.'
        }
      })
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #f8f6f3; color: #302d2a; font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; line-height: 1.6; }
  main { width: 100%; max-width: 680px; margin: 0 auto; padding: 28px 20px 40px; }
  h1, h2, p { margin: 0; }
  .brand { display: flex; align-items: center; gap: 10px; font-size: 0.9375rem; font-weight: 700; letter-spacing: -0.03em; }
  .brand-mark { width: 22px; height: 22px; border: 6px solid #b85c43; border-radius: 50%; background: #f5ded3; }
  .eyebrow { margin-top: 40px; color: #95503d; font-size: 0.8125rem; font-weight: 600; }
  h1 { margin-top: 12px; font-size: clamp(2rem, 7.5vw, 2.875rem); font-weight: 750; letter-spacing: -0.055em; line-height: 1.28; word-break: keep-all; }
  .hero-description { margin-top: 20px; color: #706860; font-size: 0.9375rem; line-height: 1.85; word-break: keep-all; }
  .desktop-break { display: none; }
  form { margin-top: 32px; padding: 24px 20px; border: 1px solid #e8e1da; border-radius: 24px; background: #fff; box-shadow: 0 8px 28px rgb(64 43 28 / 4%); }
  .card-heading { margin-bottom: 28px; }
  h2 { font-size: 1.1875rem; letter-spacing: -0.035em; line-height: 1.5; }
  .card-heading p { margin-top: 6px; color: #706860; font-size: 0.875rem; }
  .field-grid { display: grid; gap: 22px; }
  .field { min-width: 0; }
  .field > label { display: block; margin-bottom: 8px; font-size: 0.875rem; font-weight: 650; }
  .optional { margin-left: 4px; color: #766c63; font-size: 0.75rem; font-weight: 400; }
  .field input, select { display: block; width: 100%; min-width: 0; min-height: 52px; padding: 12px; border: 1px solid #ded6ce; border-radius: 12px; background: #fcfbf9; color: #302d2a; font: inherit; font-size: 1rem; }
  .field input:focus-visible, select:focus-visible, input[type='checkbox']:focus-visible, button:focus-visible { outline: 3px solid #c17a5e; outline-offset: 3px; }
  .field-help { margin-top: 7px; font-size: 0.8125rem; color: #766c63; }
  .checkbox-row { display: flex; align-items: center; gap: 10px; min-height: 48px; margin-top: 20px; padding: 10px 0; font-size: 0.875rem; cursor: pointer; }
  input[type='checkbox'] { flex: 0 0 auto; width: 20px; height: 20px; margin: 0; accent-color: #a94e37; cursor: pointer; }
  .checkbox-hint { display: block; margin-top: 2px; color: #766c63; font-size: 0.75rem; }
  button { display: block; width: 100%; min-height: 56px; margin-top: 24px; padding: 14px 20px; border: 1px solid transparent; border-radius: 14px; background: #a94e37; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  button:disabled { opacity: 0.6; cursor: wait; }
  #error-message { color: #a1372d; font-size: 0.875rem; overflow-wrap: anywhere; }
  #error-message:not(:empty) { margin-top: 16px; }
  .service-note { padding: 22px 8px 0; text-align: center; color: #766c63; font-size: 0.8125rem; line-height: 1.8; word-break: keep-all; }
  .service-note p + p { margin-top: 4px; }
  @media (hover: hover) { button:hover:not(:disabled) { background: #91402d; } }
  @media (min-width: 540px) {
    main { padding: 40px 28px 64px; }
    .eyebrow { margin-top: 56px; }
    .desktop-break { display: initial; }
    form { margin-top: 36px; padding: 32px; }
    .field-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 20px; }
  }
</style>
