---
export const prerender = false

import { env } from 'cloudflare:workers'
import { eq } from 'drizzle-orm'

import { createDb } from '../../db/client'
import { sajuProfiles } from '../../db/schema'
import { calculateSaju } from '../../lib/saju/calculator'
import { buildAnalysisFacts } from '../../lib/saju/analyzer/analysis-facts'

const { id } = Astro.params

if (!id) {
  return Astro.redirect('/')
}

const db = createDb(env.saju_db)

const profiles = await db
  .select({
    id: sajuProfiles.id,
    birthDate: sajuProfiles.birthDate,
    birthTime: sajuProfiles.birthTime,
    gender: sajuProfiles.gender,
    calendarType: sajuProfiles.calendarType,
    isLeapMonth: sajuProfiles.isLeapMonth,
  })
  .from(sajuProfiles)
  .where(eq(sajuProfiles.id, id))
  .limit(1)

const sajuProfile = profiles[0]

if (!sajuProfile) {
  return new Response('사주 정보를 찾을 수 없습니다.', {
    status: 404,
  })
}

if (
  sajuProfile.gender !== 'male' &&
  sajuProfile.gender !== 'female'
) {
  return new Response('잘못된 성별 데이터입니다.', {
    status: 500,
  })
}

if (
  sajuProfile.calendarType !== 'solar' &&
  sajuProfile.calendarType !== 'lunar'
) {
  return new Response('잘못된 달력 데이터입니다.', {
    status: 500,
  })
}

const calculation = calculateSaju({
  birthDate: sajuProfile.birthDate,
  birthTime: sajuProfile.birthTime,
  gender: sajuProfile.gender,
  calendarType: sajuProfile.calendarType,
  isLeapMonth: sajuProfile.isLeapMonth,
})

const pillarKeys = ['year', 'month', 'day', 'hour'] as const
const analysisFacts = buildAnalysisFacts(calculation)
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>사주 결과</title>
  </head>

  <body>
    <main>
      <h1>사주 정보</h1>

      <section>
        <h2>입력 정보</h2>

        <dl>
          <dt>생년월일</dt>
          <dd>{sajuProfile.birthDate}</dd>

          <dt>태어난 시간</dt>
          <dd>{sajuProfile.birthTime ?? '모름'}</dd>

          <dt>성별</dt>
          <dd>
            {sajuProfile.gender === 'male' ? '남성' : '여성'}
          </dd>

          <dt>달력</dt>
          <dd>
            {sajuProfile.calendarType === 'solar' ? '양력' : '음력'}
          </dd>

          {
            sajuProfile.calendarType === 'lunar' && (
              <>
                <dt>윤달</dt>
                <dd>
                  {sajuProfile.isLeapMonth ? '예' : '아니오'}
                </dd>
              </>
            )
          }
        </dl>
      </section>

      <section>
        <h2>사주팔자</h2>

        <table>
          <thead>
            <tr>
              <th></th>
              <th>년주</th>
              <th>월주</th>
              <th>일주</th>
              <th>시주</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <th>천간</th>
              <td>{calculation.year.stem}</td>
              <td>{calculation.month.stem}</td>
              <td>{calculation.day.stem}</td>
              <td>{calculation.hour.stem ?? '-'}</td>
            </tr>

            <tr>
              <th>지지</th>
              <td>{calculation.year.branch}</td>
              <td>{calculation.month.branch}</td>
              <td>{calculation.day.branch}</td>
              <td>{calculation.hour.branch ?? '-'}</td>
            </tr>
          </tbody>
        </table>
      </section>

      <section>
        <h2>오행</h2>
        <p>각 천간과 지지에 해당하는 오행입니다. 오행의 강약이나 비율을 뜻하지 않습니다.</p>
        <table>
          <caption>기둥별 천간·지지 오행</caption>
          <thead><tr><th scope="col">구분</th><th scope="col">년주</th><th scope="col">월주</th><th scope="col">일주</th><th scope="col">시주</th></tr></thead>
          <tbody>
            <tr><th scope="row">천간 오행</th>{pillarKeys.map((key) => <td>{calculation.elements[key]?.stem ?? '모름'}</td>)}</tr>
            <tr><th scope="row">지지 오행</th>{pillarKeys.map((key) => <td>{calculation.elements[key]?.branch ?? '모름'}</td>)}</tr>
          </tbody>
        </table>
      </section>

      <section>
        <h2>표면 오행 분포</h2>
        <p>천간·지지의 글자 수를 단순 집계한 값이며, 오행의 실제 세기나 강도를 의미하지 않습니다.</p>
        <p>{calculation.elements.hour === null ? '출생시간을 몰라 시주 2글자를 제외한 총 6글자 기준입니다.' : '년주·월주·일주·시주의 총 8글자 기준입니다.'}</p>
        <table>
          <caption>표면 오행 글자 수</caption>
          <thead><tr>{Object.keys(analysisFacts.surfaceCounts).map((element) => <th scope="col">{element}</th>)}</tr></thead>
          <tbody><tr>{Object.values(analysisFacts.surfaceCounts).map((count) => <td>{count}개</td>)}</tr></tbody>
        </table>
        <table>
          <caption>지장간 오행 글자 수</caption>
          <thead><tr>{Object.keys(analysisFacts.hiddenCounts).map((element) => <th scope="col">{element}</th>)}</tr></thead>
          <tbody><tr>{Object.values(analysisFacts.hiddenCounts).map((count) => <td>{count}개</td>)}</tr></tbody>
        </table>
      </section>

      <section>
        <h2>지장간</h2>
        <p>각 지지에 포함된 천간과 오행입니다. 본기를 먼저 나열하며, 세기나 가중치를 뜻하지 않습니다.</p>
        <table>
          <caption>지지별 지장간</caption>
          <thead><tr><th scope="col">년지</th><th scope="col">월지</th><th scope="col">일지</th><th scope="col">시지</th></tr></thead>
          <tbody><tr>{pillarKeys.map((key) => <td>{calculation.hiddenStems[key]?.map(({ stem, element }) => `${stem}(${element})`).join(', ') ?? '출생시간 모름'}</td>)}</tr></tbody>
        </table>
      </section>

      <section>
        <h2>십성</h2>
        <p>일간(나를 나타내는 천간)을 기준으로 한 관계입니다. 지지 십성은 지장간의 본기를 기준으로 표시합니다.</p>
        <table>
          <caption>일간 기준 십성</caption>
          <thead><tr><th scope="col">구분</th><th scope="col">년주</th><th scope="col">월주</th><th scope="col">일주</th><th scope="col">시주</th></tr></thead>
          <tbody>
            <tr><th scope="row">천간 십성</th>{pillarKeys.map((key) => <td>{calculation.tenGods[key]?.stem ?? '모름'}</td>)}</tr>
            <tr><th scope="row">지지 십성</th>{pillarKeys.map((key) => <td>{calculation.tenGods[key]?.branch ?? '모름'}</td>)}</tr>
          </tbody>
        </table>
        {!sajuProfile.birthTime && <p>출생시간을 몰라 시주의 오행과 십성은 표시하지 않습니다. 절기 전환일에는 출생시간에 따라 년주·월주가 달라질 수 있습니다.</p>}
      </section>
    </main>
  </body>
</html>
