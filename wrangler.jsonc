{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-08",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "saju",
	"vars": {
		"KAKAOPAY_ENVIRONMENT": "test",
		"KAKAOPAY_CID": "TC0ONETIME",
		"KAKAOPAY_CALLBACK_ORIGIN": "https://saju.dydcks4.workers.dev"
	},
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true,
		"redact_query_string": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false
		}
	},
	"ratelimits": [
		{ "name": "PROFILE_RATE_LIMIT", "namespace_id": "926021301", "simple": { "limit": 6, "period": 60 } },
		{ "name": "READY_RATE_LIMIT", "namespace_id": "926021302", "simple": { "limit": 3, "period": 60 } }
	],
	"d1_databases": [
    {
      "binding": "saju_db",
      "database_name": "saju-db",
      "database_id": "1dce25f1-9095-4758-a7bf-fbce80a74c04",
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/*/migration.sql"
    }
  ]
}
