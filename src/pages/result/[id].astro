---
export const prerender = false

import { getPaymentIdentity } from '../../lib/payments/server/payment-config'
import { env } from 'cloudflare:workers'
import { eq } from 'drizzle-orm'
import { createDb } from '../../db/client'
import { sajuProfiles } from '../../db/schema'
import { buildResultPageView } from '../../lib/saju/server/result-page'
import { loadPaidReport } from '../../lib/payments/server/paid-report'

Astro.response.headers.set('Cache-Control', 'private, no-store')

const { id } = Astro.params
if (!id) {
  return new Response('사주 정보를 찾을 수 없습니다.', { status: 404 })
}

const db = createDb(env.saju_db)
const profiles = await db
  .select({
    birthDate: sajuProfiles.birthDate,
    birthTime: sajuProfiles.birthTime,
    gender: sajuProfiles.gender,
    calendarType: sajuProfiles.calendarType,
    isLeapMonth: sajuProfiles.isLeapMonth,
  })
  .from(sajuProfiles)
  .where(eq(sajuProfiles.id, id))
  .limit(1)

const profile = profiles[0]
if (!profile) {
  return new Response('사주 정보를 찾을 수 없습니다.', { status: 404 })
}
if (profile.gender !== 'male' && profile.gender !== 'female') {
  return new Response('잘못된 성별 데이터입니다.', { status: 500 })
}
if (profile.calendarType !== 'solar' && profile.calendarType !== 'lunar') {
  return new Response('잘못된 달력 데이터입니다.', { status: 500 })
}

const paymentConfig = getPaymentIdentity()
const paid = paymentConfig ? await loadPaidReport({
  db, cookies: Astro.cookies, environment: paymentConfig.environment, profileId: id, reportYear: 2026,
}) : { entitled: false as const, status: 'unpaid' as const, report: null }

const { page: { pillars, luck, daewoonNotice }, freeHook } = buildResultPageView({
  birthDate: profile.birthDate,
  birthTime: profile.birthTime,
  gender: profile.gender,
  calendarType: profile.calendarType,
  isLeapMonth: profile.isLeapMonth,
}, !paid.entitled)

// Presentation only: preserve the supplied period and scope information.
const dateRange = (period: string) => period.match(/\d{4}-\d{2}-\d{2}/g)?.join(' ~ ') ?? period
const chapterAnimals = [
  ['🐭', '쥐'], ['🐮', '소'], ['🐯', '호랑이'], ['🐰', '토끼'], ['🐲', '용'], ['🐍', '뱀'],
  ['🐴', '말'], ['🐑', '양'], ['🐵', '원숭이'], ['🐔', '닭'], ['🐶', '개'], ['🐷', '돼지'],
] as const
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>사주 결과</title>
  </head>
  <body>
    <main>
      <a class="home-link" href="/">← 메인으로</a>
      <header class="page-header">
        <p class="eyebrow">나의 사주</p>
        <h1>사주와 운의 흐름</h1>
        <p>태어난 날의 사주와 현재 대운, 2026년 세운을 함께 살펴보세요.</p>
      </header>
      <section class="panel" aria-labelledby="pillars-heading">
        <h2 id="pillars-heading">나의 사주팔자</h2>
        <table>
          <caption>태어난 해·달·날·시간의 천간과 지지</caption>
          <thead>
            <tr><th scope="col">구분</th><th scope="col">년주</th><th scope="col">월주</th><th scope="col">일주</th><th scope="col">시주</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">천간</th>{pillars.map((pillar) => <td>{pillar.stem ?? '모름'}</td>)}</tr>
            <tr><th scope="row">지지</th>{pillars.map((pillar) => <td>{pillar.branch ?? '모름'}</td>)}</tr>
          </tbody>
        </table>
        {!profile.birthTime && <p class="notice">출생시간을 몰라 시주는 표시하지 않습니다. 절기 전환일에는 출생시간에 따라 년주·월주가 달라질 수 있습니다.</p>}
      </section>
      <section aria-labelledby="luck-heading">
        <h2 id="luck-heading">현재 대운 / 2026 세운</h2>
        <p class="section-note">대운 기준일: {luck.referenceDate} (한국시간)</p>
        <div class="luck-grid">
          <article class="panel luck-card">
            <h3>현재 대운</h3>
            {luck.currentDaewoon ? <>
              <p class="ganji">{luck.currentDaewoon.label}</p>
              <p class="period">{dateRange(luck.currentDaewoon.periodLabel)}</p>
              <details><summary>정확한 전환 시각 보기</summary><p>{luck.currentDaewoon.periodLabel}</p></details>
            </> : <p class="notice">{daewoonNotice}</p>}
          </article>
          <article class="panel luck-card">
            <h3>2026 세운</h3>
            {luck.currentAnnualLuck ? <>
              <p class="ganji">{luck.currentAnnualLuck.label}</p>
              <p class="period">{dateRange(luck.currentAnnualLuck.periodLabel)}</p>
              <details><summary>정확한 입춘 시각 보기</summary><p>{luck.currentAnnualLuck.periodLabel}</p></details>
            </> : <p class="notice">2026년 세운 정보를 확인할 수 없습니다.</p>}
          </article>
        </div>
        <p class="section-note">기간은 한국시간 기준이며, 종료 시각 직전까지 적용됩니다.</p>
      </section>
      <section class="panel" aria-labelledby="purchase-heading">
        <h2 id="purchase-heading">당신의 사주 이야기</h2>
        {paid.entitled ? <>
          <p class="access-note">결제가 완료됐어요.</p>
          {paid.report ? <div class="paid-report">
            <header class="paid-report-header">
              <p class="report-ready">당신을 위한 이야기가 준비됐어요</p>
              <h3>{paid.report.title}</h3>
              <p class="paid-intro">사주에 담긴 모습을 열두 편의 이야기로 천천히 이어가 볼게요.</p>
            </header>
            <div class="paid-story-list">
            {paid.report.sections.map((section, index) => (
              <article class="paid-topic">
                <p class="chapter-marker" aria-label={`${index + 1}번째 이야기, ${chapterAnimals[index]?.[1] ?? ''}`}>
                  <span aria-hidden="true">{chapterAnimals[index]?.[0] ?? '✦'}</span>
                </p>
                <h4>{section.headline}</h4>
                <div class="paid-body">
                  {section.body.split(/\n\n+/).filter(Boolean).map((paragraph) => <p>{paragraph}</p>)}
                </div>
              </article>
            ))}
            </div>
            {paid.report.closing && <p class="paid-closing">{paid.report.closing}</p>}
          </div> : paid.status === 'generating' ? <div id="paid-generation" class="generation" data-endpoint={`/api/reports/${encodeURIComponent(id)}`}>
            <div class="generation-heading">
              <span class="spinner" aria-hidden="true"></span>
              <div>
                <h3>당신의 사주 이야기를 풀고 있어요.</h3>
                <p>12가지 흐름을 하나씩 정리하고 있습니다.</p>
              </div>
            </div>
            <div class="chapter-skeleton" aria-hidden="true">
              {chapterAnimals.map(([animal], index) => <div class="skeleton-row">
                <span>{animal}</span><i style={`--delay:${index * 80}ms`}></i>
              </div>)}
            </div>
            <p id="generation-message" class="generation-note" role="status" aria-live="polite">잠시만 기다려 주세요. 이 화면은 자동으로 바뀝니다.</p>
            <button id="generation-recheck" class="secondary-button" type="button" hidden>다시 확인하기</button>
          </div> : <div class="generation-error">
            <p>상세 리포트를 준비하는 데 시간이 더 필요해요. 잠시 후 다시 확인해 주세요.</p>
            <button id="generation-recheck" class="secondary-button" type="button">다시 확인하기</button>
          </div>}
        </> : <>
          <p class="free-hook">{freeHook?.text}</p>
          <p class="notice">이 성향이 관계·일·선택·앞으로의 흐름에서 어떻게 나타나는지 12개의 이야기로 풀어드려요.</p>
          <p class="purchase-price">1,000원</p>
          <button id="purchase-report" type="button" data-profile-id={id} aria-describedby="purchase-test-note">상세 리포트 보기</button>
          <p id="purchase-test-note" class="purchase-note">카카오페이 테스트 결제</p>
          <p id="purchase-message" class="notice" role="status" aria-live="polite"></p>
        </>}
      </section>
      <nav class="result-links" aria-label="결과 페이지 이동">
        <a href="/">메인으로</a>
        <a href="/history">최근 결과</a>
      </nav>
    </main>
    <script>
      import { startReportPurchase } from '../../lib/payments/client/report-purchase'

      const button = document.querySelector<HTMLButtonElement>('#purchase-report')
      const message = document.querySelector<HTMLParagraphElement>('#purchase-message')
      if (button && message && button.dataset.profileId) {
        const profileId = button.dataset.profileId
        button.addEventListener('click', () => {
          void startReportPurchase(button, message, profileId)
        })
      }

      const generation = document.querySelector<HTMLElement>('#paid-generation')
      const generationMessage = document.querySelector<HTMLParagraphElement>('#generation-message')
      const recheck = document.querySelector<HTMLButtonElement>('#generation-recheck')
      const reloadWhenReady = (status: unknown) => {
        if (status === 'ready' || status === 'fallback_ready') {
          window.location.reload()
          return true
        }
        return false
      }
      const checkStatus = async (endpoint: string) => {
        const response = await fetch(endpoint, { headers: { Accept: 'application/json' }, credentials: 'same-origin' })
        if (!response.ok) return 'failed'
        const body: unknown = await response.json()
        return body && typeof body === 'object' && 'status' in body ? body.status : 'failed'
      }
      if (generation?.dataset.endpoint && generationMessage && recheck) {
        const endpoint = generation.dataset.endpoint
        let stopped = false
        const stopWithRetry = () => {
          stopped = true
          generationMessage.textContent = '준비가 조금 길어지고 있어요. 잠시 후 다시 확인해 주세요.'
          recheck.hidden = false
        }
        const poll = async () => {
          if (stopped) return
          try {
            const status = await checkStatus(endpoint)
            if (reloadWhenReady(status)) return
            if (status === 'failed' || status === 'unpaid') return stopWithRetry()
          } catch { /* Keep the calm waiting state during a temporary network failure. */ }
          window.setTimeout(() => void poll(), 2500)
        }
        recheck.addEventListener('click', () => window.location.reload())
        window.setTimeout(() => void poll(), 2500)
        void fetch(endpoint, { method: 'POST', headers: { Accept: 'application/json' }, credentials: 'same-origin' })
          .then((response) => response.ok ? response.json() : { status: 'failed' })
          .then((body: unknown) => {
            const status = body && typeof body === 'object' && 'status' in body ? body.status : 'failed'
            if (!reloadWhenReady(status) && (status === 'failed' || status === 'unpaid')) stopWithRetry()
          })
          .catch(() => stopWithRetry())
        window.setTimeout(stopWithRetry, 90000)
      } else if (recheck) {
        recheck.addEventListener('click', () => window.location.reload())
      }
    </script>
  </body>
</html>

<style>
  :global(body) { margin: 0; background: #f5f6f8; color: #24332f; font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; line-height: 1.7; }
  :global(*) { box-sizing: border-box; }
  main { max-width: 800px; margin: 0 auto; padding: 32px 16px 56px; }
  .home-link { display: inline-flex; align-items: center; min-height: 44px; margin-bottom: 20px; padding: 8px 14px; border: 1px solid #dce3df; border-radius: 10px; background: #fff; color: #255344; font-size: 0.875rem; font-weight: 700; text-decoration: none; }
  .home-link:focus-visible { outline: 2px solid #356456; outline-offset: 3px; }
  .page-header { margin-bottom: 28px; }
  h1, h2, h3, p { margin: 0; }
  h1 { font-size: clamp(1.75rem, 5vw, 2.25rem); line-height: 1.35; letter-spacing: -0.04em; }
  h2 { font-size: 1.25rem; line-height: 1.5; }
  h3 { font-size: 1.1rem; line-height: 1.5; }
  p { word-break: keep-all; overflow-wrap: anywhere; }
  .page-header > p:last-child { margin-top: 12px; color: #52625d; }
  .eyebrow { color: #356456; font-size: 0.875rem; font-weight: 700; margin-bottom: 8px; }
  section + section { margin-top: 32px; }
  .panel { background: #fff; border: 1px solid #dce3df; border-radius: 16px; padding: 20px 16px; min-width: 0; }
  table { width: 100%; table-layout: fixed; border-collapse: collapse; margin-top: 12px; text-align: center; }
  caption { text-align: left; font-size: 0.875rem; color: #52625d; margin-bottom: 16px; }
  th, td { border: 1px solid #dce3df; padding: 12px 2px; }
  th { background: #f4f7f5; font-size: 0.875rem; font-weight: 600; }
  td { font-size: 1.25rem; font-weight: 700; }
  .notice, .section-note { color: #52625d; font-size: 0.9375rem; margin-top: 12px; }
  .luck-grid { display: grid; gap: 12px; margin-top: 16px; }
  .ganji { font-size: 2rem; font-weight: 700; margin-top: 12px; color: #255344; }
  .period { font-size: 0.9375rem; font-variant-numeric: tabular-nums; }
  details { margin-top: 16px; border-top: 1px solid #e5eae7; font-size: 0.875rem; color: #52625d; }
  summary { padding: 12px 0; min-height: 44px; cursor: pointer; }
  summary:focus-visible { outline: 2px solid #356456; outline-offset: 3px; border-radius: 4px; }
  details p { padding-bottom: 4px; }
  .purchase-price { margin-top: 24px; font-size: 1.75rem; font-weight: 700; line-height: 1.3; font-variant-numeric: tabular-nums; }
  .free-hook { margin-top: 20px; padding: 24px 20px; border-left: 4px solid #356456; border-radius: 12px; background: #eaf2ed; color: #255344; font-size: clamp(1.25rem, 4.5vw, 1.6rem); font-weight: 700; line-height: 1.6; }
  #purchase-report { display: block; width: 100%; min-height: 48px; margin-top: 16px; padding: 12px 20px; border: 0; border-radius: 10px; background: #255344; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  .purchase-note { margin-top: 8px; color: #52625d; font-size: 0.8125rem; text-align: center; }
  .access-note { margin-top: 8px; color: #52625d; font-size: 0.8125rem; }
  .paid-report { margin-top: 24px; padding-top: 24px; border-top: 1px solid #dce3df; }
  .paid-report-header { max-width: 620px; }
  .report-ready { color: #356456; font-size: 0.8125rem; font-weight: 700; }
  .paid-report-header h3 { margin-top: 6px; font-size: clamp(1.45rem, 5vw, 1.85rem); overflow-wrap: anywhere; }
  .paid-intro { margin-top: 12px; color: #52625d; }
  .paid-story-list { margin-top: 36px; }
  .paid-topic { position: relative; max-width: 640px; padding: 8px 0 36px 48px; border-left: 1px solid #dce3df; }
  .paid-topic + .paid-topic { padding-top: 28px; }
  .chapter-marker { position: absolute; left: -20px; top: 2px; display: grid; width: 40px; height: 40px; place-items: center; border: 1px solid #d4e4da; border-radius: 50%; background: #f4f7f5; font-size: 1.15rem; }
  .paid-topic + .paid-topic .chapter-marker { top: 22px; }
  .paid-topic h4 { margin: 0; color: #24332f; font-size: clamp(1.15rem, 4vw, 1.35rem); line-height: 1.5; overflow-wrap: anywhere; }
  .paid-body { margin-top: 16px; color: #344640; line-height: 1.95; }
  .paid-body p + p { margin-top: 14px; }
  .paid-closing { max-width: 640px; margin-top: 8px; padding: 24px 0 4px; border-top: 1px solid #dce3df; color: #344640; line-height: 1.95; }
  .generation { margin-top: 24px; padding-top: 24px; border-top: 1px solid #dce3df; }
  .generation-heading { display: flex; align-items: flex-start; gap: 14px; }
  .generation-heading h3 { font-size: 1.2rem; }
  .generation-heading p, .generation-note { margin-top: 6px; color: #52625d; font-size: 0.9rem; }
  .spinner { flex: 0 0 auto; width: 24px; height: 24px; margin-top: 3px; border: 2px solid #d4e4da; border-top-color: #356456; border-radius: 50%; animation: spin 1s linear infinite; }
  .chapter-skeleton { display: grid; gap: 8px; margin-top: 24px; }
  .skeleton-row { display: flex; align-items: center; gap: 12px; min-height: 34px; }
  .skeleton-row span { width: 24px; text-align: center; filter: grayscale(0.35); opacity: 0.7; }
  .skeleton-row i { display: block; width: min(78%, 420px); height: 10px; border-radius: 999px; background: linear-gradient(90deg, #edf2ef 20%, #dfe9e3 45%, #edf2ef 70%); background-size: 240% 100%; animation: shimmer 1.8s ease-in-out infinite; animation-delay: var(--delay); }
  .generation-error { margin-top: 20px; color: #52625d; }
  .secondary-button { min-height: 44px; margin-top: 16px; padding: 10px 16px; border: 1px solid #b8c8c0; border-radius: 10px; background: #fff; color: #255344; font: inherit; font-weight: 700; cursor: pointer; }
  .result-links { display: flex; gap: 10px; margin-top: 32px; }
  .result-links a { flex: 1; padding: 12px 14px; border: 1px solid #dce3df; border-radius: 10px; background: #fff; color: #255344; font-weight: 700; text-align: center; text-decoration: none; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes shimmer { to { background-position: -240% 0; } }
  @media (prefers-reduced-motion: reduce) { .spinner, .skeleton-row i { animation: none; } }
  #purchase-report:disabled { opacity: 0.65; cursor: wait; }
  #purchase-report:focus-visible { outline: 2px solid #356456; outline-offset: 3px; }
  @media (min-width: 640px) {
    main { padding: 48px 24px 72px; }
    .panel { padding: 24px; }
    .luck-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    td { font-size: 1.5rem; }
  }
</style>
